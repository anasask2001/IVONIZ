# ── Content types: sitemap.xml is styled for browsers by sitemap.css ──
AddType application/xml .xml

# ── HTTPS + canonical host enforcement ──
# Canonical domain is the non-www form (matches every <link rel="canonical">
# and JSON-LD url on the site). Force HTTPS first, then collapse www to
# non-www, so every variant 301s to exactly one URL.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.ivoniz\.com$ [NC]
  RewriteRule ^(.*)$ https://ivoniz.com/$1 [L,R=301]

  # ── Moved pages (25 Nov 2026): service pages now live under their parent
  # service. Exact matches only, so /founder/founder-of-ivoniz.jpg and other
  # files are untouched. Keep these indefinitely (old links and rankings).
  RewriteRule ^flutter-app-development(?:\.html)?/?$ /mobile-app-development/flutter-app-development [R=301,L]
  RewriteRule ^ios-app-development(?:\.html)?/?$ /mobile-app-development/ios-app-development [R=301,L]
  RewriteRule ^android-app-development(?:\.html)?/?$ /mobile-app-development/android-app-development [R=301,L]
  RewriteRule ^native-app-development(?:\.html)?/?$ /mobile-app-development/native-app-development [R=301,L]
  RewriteRule ^wordpress-website-development(?:\.html)?/?$ /website-development/wordpress-website-development [R=301,L]
  RewriteRule ^static-website-development(?:\.html)?/?$ /website-development/static-website-development [R=301,L]
  RewriteRule ^ecommerce-website-development(?:\.html)?/?$ /website-development/ecommerce-website-development [R=301,L]
  RewriteRule ^woocommerce-website-development(?:\.html)?/?$ /website-development/ecommerce-website-development/woocommerce-website-development [R=301,L]
  RewriteRule ^catalogue-website-development(?:\.html)?/?$ /website-development/catalogue-website-development [R=301,L]
  RewriteRule ^web-portal-development(?:\.html)?/?$ /website-development/web-portal-development [R=301,L]
  RewriteRule ^custom-website-vs-wordpress(?:\.html)?/?$ /website-development/custom-website-vs-wordpress [R=301,L]
  RewriteRule ^best-website-development-company-in-calicut(?:\.html)?/?$ /website-development/best-website-development-company-in-calicut [R=301,L]
  RewriteRule ^erp-software-development(?:\.html)?/?$ /software-development/erp-software-development [R=301,L]
  RewriteRule ^crm-software-development(?:\.html)?/?$ /software-development/crm-software-development [R=301,L]
  RewriteRule ^billing-software-development(?:\.html)?/?$ /software-development/billing-software-development [R=301,L]
  RewriteRule ^seo-services(?:\.html)?/?$ /digital-marketing/seo-services [R=301,L]
  RewriteRule ^local-seo-services(?:\.html)?/?$ /digital-marketing/seo-services/local-seo-services [R=301,L]
  RewriteRule ^technical-seo-services(?:\.html)?/?$ /digital-marketing/seo-services/technical-seo-services [R=301,L]
  RewriteRule ^on-page-seo-services(?:\.html)?/?$ /digital-marketing/seo-services/on-page-seo-services [R=301,L]
  # Added 27 Nov 2026 (Search Console check): remaining old top-level service URLs
  RewriteRule ^off-page-seo-services(?:\.html)?/?$ /digital-marketing/seo-services/off-page-seo-services [R=301,L]
  RewriteRule ^ecommerce-seo-services(?:\.html)?/?$ /digital-marketing/seo-services/ecommerce-seo-services [R=301,L]
  RewriteRule ^seo-audit-services(?:\.html)?/?$ /digital-marketing/seo-services/seo-audit-services [R=301,L]
  RewriteRule ^social-media-marketing(?:\.html)?/?$ /digital-marketing/social-media-marketing [R=301,L]
  RewriteRule ^instagram-marketing-services(?:\.html)?/?$ /digital-marketing/social-media-marketing/instagram-marketing-services [R=301,L]
  RewriteRule ^social-media-management(?:\.html)?/?$ /digital-marketing/social-media-marketing/social-media-management [R=301,L]
  RewriteRule ^social-media-advertising(?:\.html)?/?$ /digital-marketing/social-media-marketing/social-media-advertising [R=301,L]
  RewriteRule ^social-media-content-creation(?:\.html)?/?$ /digital-marketing/social-media-marketing/social-media-content-creation [R=301,L]
  # "Best digital marketing company" pages consolidated into the hub (26 Nov 2026)
  # Also older variants Google still lists (Search Console, Nov 2026): …-in-calicut, …-company-in-kozhikode
  RewriteRule ^(?:digital-marketing/)?best-digital-marketing-(?:company-)?in-(?:calicut|kochi|kozhikode)(?:\.html)?/?$ /digital-marketing [R=301,L]
  RewriteRule ^founder(?:\.html)?/?$ /about/founder [R=301,L]
  # Human site map moved from /site-map to /sitemap (27 Nov 2026); /sitemap.xml is untouched
  RewriteRule ^site-map(?:\.html)?/?$ /sitemap [R=301,L]

  # ── Old WordPress-site URLs Google still reports as 404 (Search Console, 26 Nov 2026).
  # Those with a real equivalent today get a 301 …
  RewriteRule ^terms-and-conditions/?$ /terms [R=301,L]
  RewriteRule ^software-development-company-calicut/?$ /software-development [R=301,L]
  RewriteRule ^web-designing-company-in-malappuram/?$ /website-development/website-development-company-in-malappuram [R=301,L]
  RewriteRule ^(?:services|services-detail|solutions)/?$ / [R=301,L]
  # … and leftover WordPress/spam URLs (old casino spam, wp-json, sample post,
  # author/category archives) answer 410 Gone, so Google drops them for good.
  RewriteRule ^(?:casino|vavada-casino-2|hello-world|careers)/?$ - [G,L]
  RewriteRule ^(?:wp-json|wp-admin|wp-content|wp-includes|author|category)(?:/.*)?$ - [G,L]

  # ── Clean-URL routing for the static export ──
  # Next.js writes each page as a sibling "<route>.html" file (e.g.
  # about.html), but it ALSO creates a same-named "<route>/" directory
  # holding only internal React Server Component data fragments, with
  # no index.html inside. Apache sees that directory, finds no index,
  # and 404s -- which is exactly what happens on a hard refresh or a
  # direct visit to /about instead of navigating there via a link.

  # /about.html -> /about (301). THE_REQUEST is the original request line,
  # so this never fires on the internal .html rewrite further down.
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?] [NC]
  RewriteCond %1 !^404$
  RewriteRule ^ /%1 [R=301,L]

  # Real files (assets, _next/static chunks, etc.) are served as-is.
  # Deliberately NOT bypassing on "is a real directory" here -- every
  # page route (about/, contact/, works/, ...) is also a real
  # directory (it holds Next's RSC data fragments), and that's
  # exactly the case that needs to fall through to the .html rewrite
  # below instead of hitting Apache's directory/index handling.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # /about/  ->  /about  (canonical, no trailing slash)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /about  ->  serve about.html (URL bar still shows the clean path)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# ── Proper 404 handling ──
# Without this, Hostinger/Apache may serve a soft-404 (200 status on an
# error page), which search engines treat as duplicate/low-value content
# instead of a real 404.
ErrorDocument 404 /404.html

# ── Security headers ──
<IfModule mod_headers.c>
  # Force HTTPS on every future visit, including subdomains.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Stop browsers guessing content-types (mitigates MIME-sniffing attacks).
  Header always set X-Content-Type-Options "nosniff"

  # Block this site from being framed by other origins (clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"

  # Don't leak full referrer URLs to third parties.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Disable browser features this site never uses. Microphone stays
  # available to same-origin (the chat widget's voice input uses it).
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(self), payment=()"
</IfModule>

# ── Compression ──
# Biggest single lever on a slow connection: shrink every text response
# before it goes over the wire.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff application/font-woff
</IfModule>

# ── Caching ──
# Next.js hashes every filename under _next/static/ on build (a content
# change always ships under a new name), so those can be cached
# indefinitely. Pages and RSC data fragments (.html/.txt) must always
# revalidate, otherwise a repeat visitor on a slow connection would keep
# being served a stale page from cache after a new deploy instead of
# skipping the download that failed to matter.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
