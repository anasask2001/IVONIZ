# ── HTTPS + canonical host enforcement ──
# Canonical domain is the non-www form (matches every <link rel="canonical">
# and JSON-LD url on the site). Force HTTPS first, then collapse www to
# non-www, so every variant 301s to exactly one URL.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.ivoniz\.com$ [NC]
  RewriteRule ^(.*)$ https://ivoniz.com/$1 [L,R=301]

  # ── Clean-URL routing for the static export ──
  # Next.js writes each page as a sibling "<route>.html" file (e.g.
  # about.html), but it ALSO creates a same-named "<route>/" directory
  # holding only internal React Server Component data fragments, with
  # no index.html inside. Apache sees that directory, finds no index,
  # and 404s -- which is exactly what happens on a hard refresh or a
  # direct visit to /about instead of navigating there via a link.

  # Real files (assets, _next/static chunks, etc.) are served as-is.
  # Deliberately NOT bypassing on "is a real directory" here -- every
  # page route (about/, contact/, works/, ...) is also a real
  # directory (it holds Next's RSC data fragments), and that's
  # exactly the case that needs to fall through to the .html rewrite
  # below instead of hitting Apache's directory/index handling.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # /about/  ->  /about  (canonical, no trailing slash)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /about  ->  serve about.html (URL bar still shows the clean path)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# ── Proper 404 handling ──
# Without this, Hostinger/Apache may serve a soft-404 (200 status on an
# error page), which search engines treat as duplicate/low-value content
# instead of a real 404.
ErrorDocument 404 /404.html

# ── Security headers ──
<IfModule mod_headers.c>
  # Force HTTPS on every future visit, including subdomains.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Stop browsers guessing content-types (mitigates MIME-sniffing attacks).
  Header always set X-Content-Type-Options "nosniff"

  # Block this site from being framed by other origins (clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"

  # Don't leak full referrer URLs to third parties.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Disable browser features this site never uses. Microphone stays
  # available to same-origin (the chat widget's voice input uses it).
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(self), payment=()"
</IfModule>

# ── Compression ──
# Biggest single lever on a slow connection: shrink every text response
# before it goes over the wire.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff application/font-woff
</IfModule>

# ── Caching ──
# Next.js hashes every filename under _next/static/ on build (a content
# change always ships under a new name), so those can be cached
# indefinitely. Pages and RSC data fragments (.html/.txt) must always
# revalidate, otherwise a repeat visitor on a slow connection would keep
# being served a stale page from cache after a new deploy instead of
# skipping the download that failed to matter.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
